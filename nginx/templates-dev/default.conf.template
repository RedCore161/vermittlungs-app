# Development configuration: plain HTTP, React served by the Vite dev server.

upstream django {
    server backend:8000;
}

upstream vite {
    server frontend:5173;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    client_max_body_size 10m;

    location /api/ {
        include /etc/nginx/snippets/proxy-django.conf;
    }

    location /admin/ {
        include /etc/nginx/snippets/proxy-django.conf;
    }

    location /static/ {
        alias /var/www/django-static/;
    }

    # Vite dev server incl. websocket for hot module replacement
    location / {
        proxy_pass http://vite;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
    }
}
