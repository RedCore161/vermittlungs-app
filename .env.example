# Copy this file to `.env` and adjust the values:  cp .env.example .env
# NEVER commit the real `.env` file.

# --- Domain & HTTPS (Let's Encrypt) -----------------------------------------
# Public domain name pointing to this server (A/AAAA record).
DOMAIN=example.com
# Additional names to include in the certificate (comma separated, optional),
# e.g. www.example.com
DOMAIN_ALIASES=
# E-mail address Let's Encrypt uses for expiry notices.
LETSENCRYPT_EMAIL=admin@example.com
# 1 = use the Let's Encrypt staging CA (for testing, avoids rate limits).
LETSENCRYPT_STAGING=0
# Host ports nginx binds to (production).
HTTP_PORT=80
HTTPS_PORT=443
# Host port for the development stack (docker-compose.dev.yml).
DEV_HTTP_PORT=8080

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=vermittlung
POSTGRES_USER=vermittlung
# Generate e.g. with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
# Host port Postgres is published on in development only.
POSTGRES_HOST_PORT=5432

# --- Django ------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma separated host names Django will serve.
DJANGO_ALLOWED_HOSTS=example.com,localhost
# Comma separated origins (scheme + host) allowed to send POST requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,http://localhost:8080
DJANGO_LOG_LEVEL=INFO
# Max. login/registration attempts per client IP (DRF rate syntax).
AUTH_THROTTLE_RATE=10/min

# --- Frontend (build time) ---------------------------------------------------
# Tile server for the map. Defaults to the public OpenStreetMap tiles, which are
# fine for development/low traffic. For production traffic use your own tile
# server or a commercial OSM-based provider and set its URL/attribution here.
# Leave empty to use the defaults:
#   https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
